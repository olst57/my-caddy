# Fixed inputs for the artifact-only special build.
#
# This file is not the delivery pin surface. The delivery build and the Gate 0
# probes read pins/build-inputs.env, and tests/pins/check.sh never reads this
# file. The SPECIAL_ prefix is load-bearing: sourcing this file by mistake
# leaves the delivery PIN_* variables unset, so a delivery script fails
# immediately instead of silently building from the wrong values.
#
# This is a second artifact producer, not a delivery variant: it shares no
# Caddyfile, no patch and no release channel, and its artifacts carry the
# caddy-special- prefix so they cannot be mistaken for delivery evidence.
#
# Values are deliberate and must not float. Caddy v2.11.9 already ships the
# idle-timeout override API, so this build needs no patch and no
# source-replacement flag. It also adds no layer 4 module.
#
# Do not add delivery keys, the layer 4 pin, or an Xray pin here.

SPECIAL_CADDY_TAG=v2.11.9
SPECIAL_CADDY_COMMIT=0d98caea58f794f88e709b1bef2880996a471bca
SPECIAL_FWDPROXY_SHA=e747854e78743dba85c039b38ed185fb11d93667
SPECIAL_XCADDY_VERSION=v0.4.7
SPECIAL_GO_VERSION=1.26.9
