# Fixed inputs for the delivery binary and the Gate 0 probes.
#
# These are the fixed inputs for the delivery binary and the Gate 0 probes.
# The source pins below are the values recorded in the v0.4.3 release receipt
# (pins.txt). The Go pin was added after v0.4.3; that release's receipt records
# go1.26.10 and is not rewritten. Changing any value is a deliberate act:
# update this file, rebuild, and record the new receipt. The build no longer
# follows a fork branch head, so two builds of the same commit compile the same
# sources.
#
# PIN_XRAY_VERSION is probe-only: Xray is not linked into the Caddy binary.

PIN_CADDY_TAG=v2.11.7
PIN_CADDY_COMMIT=72dd0fb067f6d7826c7f79907670ba4a713bfe37
PIN_FWDPROXY_SHA=e747854e78743dba85c039b38ed185fb11d93667
PIN_L4_SHA=96e1a6bf063c206c3bd09ca6dc4a0484a158d83f
PIN_XCADDY_VERSION=v0.4.7
# The official naiveproxy Caddy v2.11.7-naive2 build reports this exact patch.
PIN_GO_VERSION=1.26.9
PIN_XRAY_VERSION=v26.10.31
