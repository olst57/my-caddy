# Placeholder environment file for the v0.4.0 delivery kit.
# Every value is an angle-bracket token. There is no real credential in this
# repository: the values are filled in on the deployment host, and .env itself
# is git-ignored. Key names are kept identical to deploy/PLACEHOLDERS.md.
VLESS_UUID=<VLESS_UUID>
REALITY_PRIVATE_KEY=<REALITY_PRIVATE_KEY>
REALITY_SHORT_ID=<REALITY_SHORT_ID>
NAIVE_USER=<NAIVE_USER>
NAIVE_PASSWORD=<NAIVE_PASSWORD>
