{
  "log": { "loglevel": "debug" },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 19098,
      "protocol": "vless",
      "settings": { "clients": [{ "id": "<UUID>", "flow": "xtls-rprx-vision" }], "decryption": "none" },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverNames": ["b.test"],
          "privateKey": "<REALITY_PRIVATE_KEY>",
          "shortIds": ["<SHORT_ID>"],
          "dest": "example.com:443",
          "xver": 0
        },
        "sockopt": { "acceptProxyProtocol": false }
      }
    }
  ],
  "outbounds": [{ "protocol": "freedom" }]
}
